<Window x:Class="JalaliTray.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="Height" Width="396" WindowStartupLocation="Manual"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI, Tahoma" UseLayoutRounding="True">
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="14,12,14,12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ClockText" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock x:Name="JalaliLine" FontSize="14" Margin="0,2,0,0"/>
                    <TextBlock x:Name="GregLine" FontSize="12" Foreground="{DynamicResource Muted}"/>
                    <TextBlock x:Name="HijriLine" FontSize="12" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
                <Button x:Name="SettingsBtn" Grid.Column="1" Content="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                        Width="32" Height="32" VerticalAlignment="Top" Background="Transparent" BorderThickness="0"/>
            </Grid>

            <Grid Margin="0,12,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PrevBtn" Width="32" Height="28" Background="Transparent" BorderThickness="0"/>
                <TextBlock x:Name="MonthTitle" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" FontWeight="SemiBold"/>
                <Button x:Name="TodayBtn" Grid.Column="2" Height="28" Padding="10,0" Margin="0,0,4,0"/>
                <Button x:Name="NextBtn" Grid.Column="3" Width="32" Height="28" Background="Transparent" BorderThickness="0"/>
            </Grid>

            <UniformGrid x:Name="WeekHeader" Columns="7"/>
            <UniformGrid x:Name="DaysGrid" Columns="7" Rows="6"/>

            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="SelTitle" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel x:Name="EventList" Margin="0,6,0,0"/>
                    <TextBlock x:Name="SourceText" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
