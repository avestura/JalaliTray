<Window x:Class="JalaliTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JalaliTray"
        Title="{local:Loc settings.title}" Width="480" Height="680" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI, Tahoma" FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveBtn" Content="{local:Loc save}" MinWidth="88" Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="CancelBtn" Content="{local:Loc cancel}" MinWidth="88" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="{local:Loc sec.general}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc language}"/>
                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Language, Mode=TwoWay}">
                    <ComboBoxItem Tag="fa" Content="فارسی"/>
                    <ComboBoxItem Tag="en" Content="English"/>
                </ComboBox>
                <CheckBox Content="{local:Loc digits.persian}" IsChecked="{Binding PersianDigits, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc theme}"/>
                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Theme, Mode=TwoWay}">
                    <ComboBoxItem Tag="System" Content="{local:Loc theme.system}"/>
                    <ComboBoxItem Tag="Light" Content="{local:Loc theme.light}"/>
                    <ComboBoxItem Tag="Dark" Content="{local:Loc theme.dark}"/>
                </ComboBox>
                <CheckBox Content="{local:Loc startup}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>

                <TextBlock Style="{StaticResource Section}" Text="{local:Loc sec.tray}"/>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc font}" Margin="0,0,0,4"/>
                <ComboBox x:Name="FontBox" IsEditable="True" Text="{Binding IconFont, Mode=TwoWay}"/>
                <CheckBox Content="{local:Loc bold}" IsChecked="{Binding IconBold, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc bgcolor}"/>
                <TextBox Text="{Binding IconBackground, Mode=TwoWay}" FlowDirection="LeftToRight"/>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc fgcolor}"/>
                <TextBox Text="{Binding IconForeground, Mode=TwoWay}" FlowDirection="LeftToRight"/>

                <TextBlock Style="{StaticResource Section}" Text="{local:Loc sec.time}"/>
                <CheckBox Content="{local:Loc ntp.enable}" IsChecked="{Binding NtpEnabled, Mode=TwoWay}" Margin="0"/>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc ntp.server}"/>
                <TextBox Text="{Binding NtpServer, Mode=TwoWay}" FlowDirection="LeftToRight"/>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc ntp.interval}"/>
                <TextBox Text="{Binding NtpIntervalHours, Mode=TwoWay}" Width="80" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="TestBtn" Content="{local:Loc ntp.test}" Padding="12,4"/>
                    <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Muted}"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="{local:Loc sec.calendar}"/>
                <CheckBox Content="{local:Loc show.hijri}" IsChecked="{Binding ShowHijri, Mode=TwoWay}" Margin="0"/>
                <CheckBox Content="{local:Loc show.greg}" IsChecked="{Binding ShowGregorian, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc hijri.offset}"/>
                <ComboBox x:Name="HijriBox" SelectedItem="{Binding HijriOffset, Mode=TwoWay}" Width="80" HorizontalAlignment="Left"/>

                <TextBlock Style="{StaticResource Section}" Text="{local:Loc sec.events}"/>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc api.key}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ApiKey, Mode=TwoWay}" FlowDirection="LeftToRight"/>
                <TextBlock Text="{local:Loc api.hint}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <CheckBox Content="{local:Loc ev.holiday}" IsChecked="{Binding ShowHolidays, Mode=TwoWay}"/>
                <CheckBox Content="{local:Loc ev.religious}" IsChecked="{Binding ShowReligious, Mode=TwoWay}"/>
                <CheckBox Content="{local:Loc ev.national}" IsChecked="{Binding ShowNational, Mode=TwoWay}"/>
                <CheckBox Content="{local:Loc ev.other}" IsChecked="{Binding ShowOther, Mode=TwoWay}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
